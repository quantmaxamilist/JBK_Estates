---
import Layout from '../../layouts/Layout.astro';
import PageShell from '../../components/PageShell.astro';
import TaglineBar from '../../components/TaglineBar.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { contacts, site } from '../../data/site';
---

<Layout
  title="Contact Us | JBK Estates Ltd"
  description={`Contact JBK Estates Ltd. Call ${site.phone} or email ${site.email}.`}
>
  <PageShell>
    <TaglineBar />
    <CategoryNav />

    <section class="section-padding">
      <div class="container-narrow">
        <h1 class="mb-10 font-display text-4xl font-semibold text-grey">Contact Us</h1>
        <div class="grid gap-10 sm:grid-cols-2">
          {
            contacts.map((c) => (
              <div>
                <p class="mb-2 font-display text-lg font-semibold text-grey">{c.name}</p>
                <a href={c.phoneHref} class="block text-base text-grey hover:text-red">
                  {c.phone}
                </a>
                <a href={c.emailHref} class="block text-base text-grey hover:text-red">
                  {c.email}
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </PageShell>
</Layout>
