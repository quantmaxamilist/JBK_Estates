---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { services } from '../data/services';
import { galleryItems } from '../data/gallery';

const categoryForService: Record<string, string> = {
  'extensions-conversions': 'extensions-conversions',
  'house-refurbishments': 'house-refurbishments',
  'kitchens-bathrooms': 'kitchens-bathrooms',
  'general-building': 'general-building-works',
  'new-builds': 'new-builds',
};
---

<Layout
  title="Services | JBK Estates Ltd"
  description="Extensions and conversions, house refurbishments, kitchens and bathrooms, general building works and new builds."
>
  <PageShell>
    <PageHeader
      eyebrow="Services"
      title="What we build"
      lede="Domestic building and development work, priced against the drawings and the condition of the building."
      image="/images/projects/new-builds/12.jpg"
    />

    <section class="section-padding">
      <div class="container-narrow space-y-6">
        {
          services.map((s, i) => {
            const photos = galleryItems.filter((g) => g.category === categoryForService[s.slug]).slice(0, 4);
            return (
              <article
                id={s.slug}
                class="scroll-mt-28 border-l-4 border-brick bg-paper p-6 shadow-[0_2px_16px_-8px_rgba(28,28,28,0.18)] md:p-8"
                data-reveal
              >
                <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
                  <div>
                    <div class="mb-4 flex items-center gap-4">
                      <span class="icon-badge">
                        <ServiceIcon slug={s.slug} class="h-5 w-5" />
                      </span>
                      <span class="font-display text-sm font-bold text-brick">0{i + 1}</span>
                    </div>
                    <h2 class="mb-2 font-display text-2xl font-bold">{s.title}</h2>
                    <p class="mb-3 max-w-prose text-ink">{s.summary}</p>
                    <p class="max-w-prose text-sm leading-relaxed text-muted">{s.detail}</p>
                    <a href={`/gallery`} class="mt-4 inline-block text-sm font-semibold text-brick hover:underline">
                      See more {s.title.toLowerCase()} photos
                    </a>
                  </div>
                  {photos.length > 0 && (
                    <div class="grid grid-cols-2 gap-2">
                      {photos.map((p) => (
                        <div class="aspect-[4/3] overflow-hidden bg-mist">
                          <img src={p.src} alt={p.alt} loading="lazy" class="h-full w-full object-cover" />
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <CtaBand />
  </PageShell>
</Layout>
