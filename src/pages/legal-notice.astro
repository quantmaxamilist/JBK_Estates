---
import Layout from '../layouts/Layout.astro';
import PageShell from '../components/PageShell.astro';
import { site } from '../data/site';
---

<Layout
  title="Legal Notice | JBK Estates Ltd"
  description="Company details for JBK Estates Ltd."
>
  <PageShell>
    <section class="section-padding">
      <div class="container-narrow max-w-3xl">
        <p class="eyebrow mb-3">Legal</p>
        <h1 class="mb-8 font-display text-4xl font-bold">Legal Notice</h1>
        <div class="space-y-5 text-sm leading-relaxed text-muted">
          <p>
            This website is operated by {site.legalName}.
          </p>
          <p>
            Registered office: {site.address}. Company number {site.companyNumber}. The office address shown on this site is a placeholder pending confirmation.
          </p>
          <p>
            Telephone: <a href={site.phoneHref} class="text-ink underline">{site.phone}</a>. Email: <a href={site.emailHref} class="text-ink underline">{site.email}</a>.
          </p>
          <p>
            The content on this site is for general information. Quotes are given in writing against drawings or a brief. We may update services and copy without notice.
          </p>
        </div>
      </div>
    </section>
  </PageShell>
</Layout>
