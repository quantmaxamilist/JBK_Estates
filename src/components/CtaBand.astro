---
import { site } from '../data/site';
---

<section class="border-y border-hairline bg-mist section-padding">
  <div class="container-narrow flex flex-col items-start justify-between gap-8 md:flex-row md:items-center" data-reveal>
    <div>
      <p class="eyebrow mb-3">Next step</p>
      <h2 class="mb-3 font-display text-3xl font-bold text-ink md:text-4xl">Send the drawings or a brief.</h2>
      <p class="max-w-xl text-ink/70">
        Get in touch with the details of the job and we'll come back with a price.
      </p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="/contact" class="btn-primary">{site.ctaPrimary}</a>
      <a href={site.phoneHref} class="btn-ghost">{site.ctaSecondary}</a>
    </div>
  </div>
</section>
