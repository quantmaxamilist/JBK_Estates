---
interface Props {
  compact?: boolean;
  inverted?: boolean;
}

const { compact = false, inverted = false } = Astro.props;
---

<span class:list={['logo', compact && 'logo--compact', inverted && 'logo--inverted']}>
  <img src="/images/brand/roof-icon.png" alt="" class="logo__mark" aria-hidden="true" />
  <span class="logo__type">
    <span class="logo__name">JBK Estates</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-ink);
  }

  .logo--inverted {
    color: var(--color-paper);
  }

  .logo__mark {
    width: 3.4rem;
    height: auto;
    flex-shrink: 0;
    display: block;
  }

  .logo--compact .logo__mark {
    width: 2.9rem;
  }

  .logo__type {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .logo--compact .logo__name {
    font-size: 0.95rem;
  }

  @media (min-width: 768px) {
    .logo__mark {
      width: 3.8rem;
    }

    .logo__name {
      font-size: 1.15rem;
    }
  }
</style>
