---
import { site } from '../data/site';
---

<section class="border-b border-hairline bg-mist">
  <div class="section-padding pb-10 pt-24 md:pb-14 md:pt-28">
    <div class="container-narrow grid gap-14 lg:grid-cols-[minmax(0,1fr)_30rem] lg:items-start lg:gap-16">
      <div>
        <p class="eyebrow mb-4">Hertfordshire · Essex · Building &amp; development</p>
        <h1 class="mb-5 font-display text-4xl font-bold leading-[1.05] text-ink md:text-6xl">
          Extensions, conversions, refurbishments and new builds.
        </h1>
        <p class="mb-8 max-w-xl text-base leading-relaxed text-ink/70 md:text-lg">
          We work from the drawings — yours or our architect's — and carry the job through to finish.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href="/contact" class="btn-primary">{site.ctaPrimary}</a>
          <a href="/gallery" class="btn-ghost">View recent work</a>
        </div>
        <p class="mt-6 text-sm text-ink/70">We are always looking for new plots and developments.</p>
      </div>

      <div class="photo-frame mx-auto w-full max-w-lg lg:mx-0 lg:max-w-none">
        <div class="photo-frame__img-wrap aspect-[4/3]">
          <img
            src="/images/hero/hero.jpg"
            alt="A recently completed new-build house with brick exterior and dormer windows"
            class="block h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
