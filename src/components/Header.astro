---
import { site } from '../data/site';
---

<header class="bg-paper">
  <div class="container-narrow flex items-center justify-between gap-4 px-5 py-6 md:px-8 lg:px-12">
    <a href="/" class="block shrink-0" aria-label={`${site.name} — Home`}>
      <img src="/images/brand/logo-full.png" alt={site.name} class="h-20 w-auto md:h-24" width="333" height="150" />
    </a>
    <a href="/contact-us/" class="btn-primary">
      {site.ctaPrimary}
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.24.2 2.45.57 3.57a1 1 0 01-.25 1.02l-2.2 2.2z" />
      </svg>
    </a>
  </div>
</header>
