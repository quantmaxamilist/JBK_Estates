---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  constrain?: boolean;
  image?: string;
}

const { eyebrow, title, lede, constrain = false, image } = Astro.props;
---

{
  image ? (
    <section class="border-b border-hairline bg-mist px-5 py-10 md:px-8 md:py-14 lg:px-12">
      <div class:list={['container-narrow grid gap-8 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-center lg:gap-12', constrain && 'max-w-3xl lg:grid-cols-1']}>
        <div>
          <p class="eyebrow mb-3" data-reveal>
            {eyebrow}
          </p>
          <span class="mb-4 block h-px w-12 bg-brick" aria-hidden="true" data-reveal />
          <h1 class="mb-4 font-display text-4xl font-bold text-ink md:text-5xl" data-reveal>
            {title}
          </h1>
          {lede && (
            <p class="max-w-2xl text-lg text-ink/70" data-reveal>
              {lede}
            </p>
          )}
        </div>
        <div class="photo-frame mx-auto w-full max-w-sm lg:mx-0 lg:max-w-none" data-reveal>
          <div class="photo-frame__img-wrap aspect-[4/3]">
            <img src={image} alt="" class="block h-full w-full object-cover" />
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="section-padding border-b border-hairline bg-mist">
      <div class:list={['container-narrow', constrain && 'max-w-3xl']}>
        <p class="eyebrow mb-3" data-reveal>
          {eyebrow}
        </p>
        <span class="mb-4 block h-px w-12 bg-brick" aria-hidden="true" data-reveal />
        <h1 class="mb-4 font-display text-4xl font-bold text-ink md:text-5xl" data-reveal>
          {title}
        </h1>
        {lede && (
          <p class="max-w-2xl text-lg text-muted" data-reveal>
            {lede}
          </p>
        )}
      </div>
    </section>
  )
}
