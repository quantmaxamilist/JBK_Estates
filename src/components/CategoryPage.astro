---
import Layout from '../layouts/Layout.astro';
import PageShell from './PageShell.astro';
import TaglineBar from './TaglineBar.astro';
import CategoryNav from './CategoryNav.astro';
import ProjectRow from './ProjectRow.astro';
import { getCategory } from '../data/projects';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const category = getCategory(slug);
---

<Layout title={`${category.pageTitle} | JBK Estates Ltd`} description={category.pageDescription}>
  <PageShell>
    <TaglineBar />
    <CategoryNav />

    {
      category.projects.map((project, i) => (
        <ProjectRow
          as={i === 0 ? 'h1' : 'h2'}
          title={project.heading}
          text={project.text}
          image={project.photos[0].src}
          imageAlt={project.photos[0].alt}
          lightboxGroup={i}
        />
      ))
    }
  </PageShell>
</Layout>

<dialog id="lightbox" class="max-h-[100dvh] max-w-[100vw] border-0 bg-ink/95 p-0 text-white backdrop:bg-ink/80">
  <div class="relative flex min-h-[100dvh] min-w-[100vw] flex-col items-center justify-center px-4 py-16">
    <button
      type="button"
      id="lightbox-close"
      class="absolute right-4 top-4 z-10 min-h-11 min-w-11 border border-white/30 text-xs uppercase tracking-widest hover:border-red"
      aria-label="Close"
    >
      Close
    </button>
    <button
      type="button"
      id="lightbox-prev"
      class="absolute left-4 top-1/2 z-10 min-h-11 min-w-11 -translate-y-1/2 border border-white/30 text-xs uppercase tracking-widest hover:border-red"
      aria-label="Previous photo"
    >
      Prev
    </button>
    <button
      type="button"
      id="lightbox-next"
      class="absolute right-4 top-1/2 z-10 min-h-11 min-w-11 -translate-y-1/2 border border-white/30 text-xs uppercase tracking-widest hover:border-red"
      aria-label="Next photo"
    >
      Next
    </button>
    <img id="lightbox-image" src="" alt="" class="max-h-[78dvh] w-auto max-w-[90vw] object-contain" />
    <p id="lightbox-counter" class="mt-3 text-xs tabular-nums text-white/50"></p>
  </div>
</dialog>

<script define:vars={{ groups: category.projects.map((p) => p.photos) }}>
  const dialog = document.getElementById('lightbox');
  const img = document.getElementById('lightbox-image');
  const counter = document.getElementById('lightbox-counter');
  let currentGroup = 0;
  let currentIndex = 0;

  const openAt = (group, index) => {
    if (!dialog || !img || !counter) return;
    const photos = groups[group];
    if (!photos || !photos.length) return;
    currentGroup = group;
    currentIndex = ((index % photos.length) + photos.length) % photos.length;
    const photo = photos[currentIndex];
    img.src = photo.src;
    img.alt = photo.alt;
    counter.textContent = `${currentIndex + 1} / ${photos.length}`;
    if (!dialog.open) dialog.showModal();
  };

  const step = (dir) => openAt(currentGroup, currentIndex + dir);

  document.querySelectorAll('[data-lightbox-group]').forEach((btn) => {
    btn.addEventListener('click', () =>
      openAt(Number(btn.dataset.lightboxGroup), Number(btn.dataset.lightboxStart || 0)),
    );
  });

  document.getElementById('lightbox-close')?.addEventListener('click', () => dialog?.close());
  document.getElementById('lightbox-prev')?.addEventListener('click', () => step(-1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => step(1));
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  document.addEventListener('keydown', (e) => {
    if (!dialog?.open) return;
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
</script>
